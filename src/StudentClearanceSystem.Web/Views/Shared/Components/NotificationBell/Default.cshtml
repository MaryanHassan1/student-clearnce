@model List<Notification>
@{
    var unreadCount = Model.Count(n => !n.IsRead);
}
<div class="dropdown">
    <button class="topbar-icon-btn" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
        @if (unreadCount > 0)
        {
            <span class="topbar-badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
        }
    </button>
    <ul class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown">
        <li><h6 class="dropdown-header px-2">Notifications</h6></li>
        @if (!Model.Any())
        {
            <li><span class="dropdown-item-text text-muted">No notifications yet.</span></li>
        }
        else
        {
            foreach (var n in Model)
            {
                <li>
                    <div class="dropdown-item-text @(n.IsRead ? "text-muted" : "")" style="white-space: normal;">
                        <div style="font-size:.85rem; @(n.IsRead ? "" : "font-weight:600;")">@n.Message</div>
                        <small class="text-muted">@n.CreatedDate.ToString("g")</small>
                    </div>
                </li>
            }
        }
    </ul>
</div>
