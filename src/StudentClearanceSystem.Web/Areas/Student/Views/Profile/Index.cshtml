@model Student
@{
    ViewData["Title"] = "My Profile";
    var initials = Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "?";
}

<div class="page-heading">
    <div>
        <h3>My Profile</h3>
        <div class="text-muted">Your student record on file with the university.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <img src="@Model.ProfilePicturePath" alt="Profile picture" class="rounded-circle mb-3" style="width:110px;height:110px;object-fit:cover;" />
                }
                else
                {
                    <div class="user-avatar mx-auto mb-3" style="width:110px;height:110px;font-size:2.2rem;">@initials</div>
                }
                <h5 class="mb-1">@Model.FullName</h5>
                <p class="text-muted mb-0">@Model.RegistrationNumber</p>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">Gender</dt><dd class="col-sm-8">@Model.Gender</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Faculty</dt><dd class="col-sm-8">@Model.Faculty?.Name</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Department</dt><dd class="col-sm-8">@Model.Department?.Name</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Program</dt><dd class="col-sm-8">@Model.Program</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Academic Year</dt><dd class="col-sm-8 mb-0">@Model.AcademicYear</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
