@{
    ViewData["Title"] = "Reports";
    var reports = new (string Key, string Label, string Description, string Tone, string IconPath)[]
    {
        ("students", "All Students", "Every registered student and their record.", "secondary", "<circle cx='9' cy='8' r='3.2'/><path d='M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6'/><circle cx='17.3' cy='8.7' r='2.3'/><path d='M15.6 14.3c2.6.5 4.6 2.6 4.6 5.7'/>"),
        ("pending", "Pending Clearance", "Requests still awaiting department decisions.", "warning", "<circle cx='12' cy='12' r='8.5'/><path d='M12 7.5V12l3 2'/>"),
        ("completed", "Completed Clearance", "Requests approved by every department.", "success", "<path d='M4 12.5l5 5L20 6.5'/>"),
        ("rejected", "Rejected Clearance", "Items currently rejected by a department.", "danger", "<circle cx='12' cy='12' r='8.5'/><path d='M9 9l6 6M15 9l-6 6'/>"),
        ("graduation-approved", "Graduation Approved", "Students approved for graduation.", "info", "<path d='M4 21V9l8-5 8 5v12'/><path d='M9 21v-6h6v6M4 21h16'/>"),
        ("graduated", "Graduated Students", "Students marked as fully graduated.", "purple", "<path d='M4 5l8-2.5L20 5v3l-8 2.5L4 8V5Z'/><path d='M8 10.2V15c0 1.5 1.8 3 4 3s4-1.5 4-3v-4.8'/>")
    };
}

<div class="page-heading">
    <div>
        <h3>Reports</h3>
        <div class="text-muted">Search, filter, print, and export clearance and graduation data. Click a card to open it.</div>
    </div>
</div>

<div class="row g-3">
    @foreach (var report in reports)
    {
        <div class="col-md-6 col-xl-4">
            <a class="card tone-@report.Tone h-100" asp-action="Report" asp-route-key="@report.Key">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="stat-card-icon tone-@report.Tone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(report.IconPath)</svg>
                        </div>
                        <h5 class="card-title mb-0">@report.Label</h5>
                    </div>
                    <p class="text-muted small mb-0">@report.Description</p>
                </div>
            </a>
        </div>
    }
</div>
