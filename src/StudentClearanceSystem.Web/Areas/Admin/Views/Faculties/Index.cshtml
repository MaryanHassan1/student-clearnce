@model List<Faculty>
@{
    ViewData["Title"] = "Faculties";
}

<div class="page-heading">
    <div>
        <h3>Faculties</h3>
        <div class="text-muted">Academic faculties used to organize departments and students.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Faculty</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var faculty in Model)
                    {
                        <tr>
                            <td>@faculty.Name</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@faculty.FacultyId">Edit</a>
                                <form asp-action="Delete" asp-route-id="@faculty.FacultyId" method="post" class="d-inline" onsubmit="return confirm('Delete this faculty?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="2" class="text-center text-muted py-4">No faculties yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
