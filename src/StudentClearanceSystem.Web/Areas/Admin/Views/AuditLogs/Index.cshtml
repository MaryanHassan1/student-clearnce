@model PaginatedList<AuditLog>
@{
    ViewData["Title"] = "Audit Log";
}

<div class="page-heading">
    <div>
        <h3>Audit Log</h3>
        <div class="text-muted">A record of every administrative action taken in the system.</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.Timestamp.ToString("g")</td>
                            <td>@log.User?.FullName</td>
                            <td><span class="badge bg-secondary">@log.Action</span></td>
                            <td>@log.EntityName @(log.EntityId.HasValue ? $"#{log.EntityId}" : "")</td>
                            <td>@log.Details</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No audit log entries yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination mb-0">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
